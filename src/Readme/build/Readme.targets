<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    Readme package targets:
    1. Auto-mark the package readme for packing (SDK Pack + NuGetizer item metadata).
    2. Resolve include directives into $(BaseIntermediateOutputPath) and pack that file.
    PackageReadmeFile is inferred here (after the project file), not in .props, so
    PackReadme=false in the csproj wins and clears any residual PackageReadmeFile (NU5039).
  -->

  <PropertyGroup>
    <_ReadmeTaskAssembly Condition="'$(_ReadmeTaskAssembly)' == ''">$(MSBuildThisFileDirectory)Readme.dll</_ReadmeTaskAssembly>
  </PropertyGroup>

  <UsingTask TaskName="Readme.ProcessReadmeIncludes" AssemblyFile="$(_ReadmeTaskAssembly)"
             Condition="Exists('$(_ReadmeTaskAssembly)')" />

  <!--
    PackReadme=false: clear PackageReadmeFile so SDK Pack does not expect a packed readme.
    Also covers PackageReadmeFile set earlier by Directory.Build.* or other imports.
  -->
  <PropertyGroup Condition="'$(PackReadme)' == 'false'">
    <PackageReadmeFile></PackageReadmeFile>
    <PackageReadmeFilename></PackageReadmeFilename>
    <PackageReadmeExtension></PackageReadmeExtension>
  </PropertyGroup>

  <!-- Infer PackageReadmeFile only when packing readme (project props already evaluated). -->
  <PropertyGroup Label="Package Readme" Condition="'$(PackReadme)' == 'true'">
    <PackageReadmeFilename Condition="'$(PackageReadmeFilename)' == ''">readme</PackageReadmeFilename>
    <PackageReadmeExtension Condition="'$(PackageReadmeExtension)' == ''">.md</PackageReadmeExtension>

    <PackageReadmeFilename Condition="'$(PackageReadmeFile)' != ''">$([System.IO.Path]::GetFileNameWithoutExtension('$(PackageReadmeFile)'))</PackageReadmeFilename>
    <PackageReadmeExtension Condition="'$(PackageReadmeFile)' != ''">$([System.IO.Path]::GetExtension('$(PackageReadmeFile)'))</PackageReadmeExtension>

    <PackageReadmeFile Condition="'$(PackageReadmeFile)' == '' and Exists('$(MSBuildProjectDirectory)\$(PackageReadmeFilename)$(PackageReadmeExtension)')">$(PackageReadmeFilename)$(PackageReadmeExtension)</PackageReadmeFile>
  </PropertyGroup>

  <!--
    Auto-pack the project readme for packable projects (SDK Pack item metadata).
    NuGetizer also infers the readme via PackageReadmeFile; this keeps SDK Pack working
    without Directory.Build.* help and without NuGetizer.
  -->
  <ItemGroup Condition="'$(IsPackable)' == 'true' and '$(PackReadme)' == 'true' and '$(PackageReadmeFile)' != ''">
    <None Update="@(None -> WithMetadataValue('Filename', '$(PackageReadmeFilename)'))"
          Pack="true"
          PackagePath="$(PackageReadmeFilename)$(PackageReadmeExtension)"
          CopyToOutputDirectory="Never" />

    <!-- Explicit include when the readme is not already a None item (non-SDK or custom layout). -->
    <None Include="$(MSBuildProjectDirectory)\$(PackageReadmeFile)"
          Pack="true"
          PackagePath="$(PackageReadmeFilename)$(PackageReadmeExtension)"
          CopyToOutputDirectory="Never"
          Condition="Exists('$(MSBuildProjectDirectory)\$(PackageReadmeFile)') and '@(None->WithMetadataValue('Filename', '$(PackageReadmeFilename)'))' == ''" />
  </ItemGroup>

  <!-- Opt-out: do not pack a project-level readme when PackReadme=false. -->
  <ItemGroup Condition="'$(PackReadme)' == 'false'">
    <None Update="@(None -> WithMetadataValue('Filename', 'readme'))" Pack="false" />
    <Content Update="@(Content -> WithMetadataValue('Filename', 'readme'))" Pack="false" />
  </ItemGroup>

  <!--
    Late clear: Directory.Build.targets may set PackageReadmeFile after our evaluation-time clear.
    Ensure SDK Pack never sees PackageReadmeFile without a packed file (NU5039).
  -->
  <Target Name="ClearPackageReadmeWhenPackReadmeFalse"
          BeforeTargets="GenerateNuspec;_GetPackageFiles;GetPackageContents;_GetPackageFilesFromPack"
          Condition="'$(PackReadme)' == 'false'">
    <PropertyGroup>
      <PackageReadmeFile></PackageReadmeFile>
    </PropertyGroup>
    <ItemGroup>
      <None Update="@(None -> WithMetadataValue('Filename', 'readme'))" Pack="false" />
      <Content Update="@(Content -> WithMetadataValue('Filename', 'readme'))" Pack="false" />
    </ItemGroup>
  </Target>

  <!-- Process includes; retarget pack sources to the intermediate file (SDK Pack + NuGetizer). -->
  <Target Name="ProcessPackageReadmeIncludes"
          BeforeTargets="GenerateNuspec;_GetPackageFiles;GetPackageContents;_GetPackageFilesFromPack"
          Condition="'$(IsPackable)' == 'true' and '$(PackReadme)' == 'true' and '$(PackageReadmeFile)' != '' and Exists('$(_ReadmeTaskAssembly)')">

    <PropertyGroup>
      <!-- Prefer project-directory readme as the source of includes. -->
      <_ReadmeSourceFile Condition="'$(_ReadmeSourceFile)' == '' and Exists('$(MSBuildProjectDirectory)\$(PackageReadmeFile)')">$(MSBuildProjectDirectory)\$(PackageReadmeFile)</_ReadmeSourceFile>
      <_ReadmeSourceFile Condition="'$(_ReadmeSourceFile)' == '' and Exists('$(PackageReadmeFile)')">$(PackageReadmeFile)</_ReadmeSourceFile>

      <!-- Package path filename (readme.md by default). -->
      <_ReadmePackagePath Condition="'$(_ReadmePackagePath)' == ''">$(PackageReadmeFilename)$(PackageReadmeExtension)</_ReadmePackagePath>
      <_ReadmePackagePath Condition="'$(_ReadmePackagePath)' == ''">$([System.IO.Path]::GetFileName('$(PackageReadmeFile)'))</_ReadmePackagePath>

      <!-- Processed file always under BaseIntermediateOutputPath. -->
      <_ReadmeProcessedFile>$([System.IO.Path]::Combine('$(BaseIntermediateOutputPath)', '$(_ReadmePackagePath)'))</_ReadmeProcessedFile>
    </PropertyGroup>

    <ProcessReadmeIncludes Condition="'$(_ReadmeSourceFile)' != '' and Exists('$(_ReadmeSourceFile)')"
                           SourceFile="$(_ReadmeSourceFile)"
                           OutputFile="$(_ReadmeProcessedFile)"
                           AllowedSchemes="$(ReadmeIncludeScheme)"
                           AllowedDomains="@(ReadmeIncludeDomain)" />

    <!-- Stop packing the unprocessed source; pack the intermediate processed file instead. -->
    <ItemGroup Condition="Exists('$(_ReadmeProcessedFile)')">
      <None Update="@(None -> WithMetadataValue('Filename', '$(PackageReadmeFilename)'))"
            Pack="false" />
      <Content Update="@(Content -> WithMetadataValue('Filename', '$(PackageReadmeFilename)'))"
               Pack="false" />

      <!-- Remove prior intermediate entries to avoid duplicates across incremental runs. -->
      <None Remove="$(_ReadmeProcessedFile)" />
      <None Include="$(_ReadmeProcessedFile)"
            Pack="true"
            PackagePath="$(_ReadmePackagePath)"
            CopyToOutputDirectory="Never"
            Visible="false" />
    </ItemGroup>

    <!-- Keep PackageReadmeFile as the in-package path (filename). -->
    <PropertyGroup Condition="Exists('$(_ReadmeProcessedFile)')">
      <PackageReadmeFile>$(_ReadmePackagePath)</PackageReadmeFile>
    </PropertyGroup>
  </Target>

  <!--
    NuGetizer packs via @(PackageFile) after GetPackageContents; retarget those to the processed intermediate.
    Safe no-op when NuGetizer is not present (PackageFile empty / target never produced items).
  -->
  <Target Name="RetargetNuGetizerProcessedReadme"
          AfterTargets="GetPackageContents"
          Condition="'$(IsPackable)' == 'true' and '$(PackReadme)' == 'true' and '$(_ReadmeProcessedFile)' != '' and Exists('$(_ReadmeProcessedFile)')">

    <ItemGroup>
      <_ReadmePackageFile Include="@(PackageFile)"
                          Condition="'%(PackageFile.PackagePath)' == '$(_ReadmePackagePath)' or '%(PackageFile.PackagePath)' == '$(PackageReadmeFile)'" />
      <PackageFile Remove="@(_ReadmePackageFile)" />
      <PackageFile Include="$(_ReadmeProcessedFile)">
        <PackagePath>$(_ReadmePackagePath)</PackagePath>
        <PackFolder>None</PackFolder>
        <PackageId Condition="'$(IsPackable)' == 'true'">$(PackageId)</PackageId>
        <TargetFramework></TargetFramework>
        <DefaultTargetFramework></DefaultTargetFramework>
      </PackageFile>
    </ItemGroup>
  </Target>
</Project>
