<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!--
    This project is plain SDK Pack (no NuGetizer). Self-host bootstrap for the task assembly
    lives ONLY here — never in shipped build/Readme.targets.

    Task locking: UsingTask locks AssemblyFile for the MSBuild node lifetime. Loading
    $(TargetPath) or build/Readme.dll blocks Compile/Copy (MSB3027). So we:
      1. Copy the built DLL to a fixed shadow under obj/Readme.Task/ (Build never writes there).
      2. Register UsingTask on that shadow *before* importing build/Readme.targets (first wins).
      3. Hook Prepare via ProcessPackageReadmeDependsOn (extension point in shipped targets).
      4. ContinueOnError on shadow Copy so re-entry after the node already locked the file is OK.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>Readme</PackageId>
    <Description>
      Automatic package readme packing, include-directive resolution, token replacement,
      and GitHub relative URL expansion at pack time.
      Works with SDK Pack and NuGetizer: processes includes into BaseIntermediateOutputPath and packs that file.
    </Description>
    <PackageTags>readme nuget pack include markdown msbuild github</PackageTags>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <Nullable>enable</Nullable>
    <LangVersion>Latest</LangVersion>
    <ILRepack>true</ILRepack>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="18.9.6" PrivateAssets="all" />
    <PackageReference Include="Markdig" Version="1.3.2" PrivateAssets="all" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ILRepackInclude Include="Markdig" />
    <ILRepackInclude Include="System.Buffers" />
    <ILRepackInclude Include="System.Memory" />
    <ILRepackInclude Include="System.Numerics.Vectors" />
    <ILRepackInclude Include="System.Runtime.CompilerServices.Unsafe" />
  </ItemGroup>

  <!--
    Pack assets via TfmSpecificPackageFile (SDK Pack recommended path). None/Content Pack=
    metadata is unreliable here: Directory.Build + IncludeBuildOutput=false leave Pack=false
    by collect time. Dev-only — not in shipped targets.
  -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>
      $(TargetsForTfmSpecificContentInPackage);
      AddReadmePackageAssets
    </TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="CopyTaskAssemblyToBuild" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\build" SkipUnchangedFiles="true" />
    <ItemGroup>
      <FileWrites Include="$(MSBuildProjectDirectory)\build\$(TargetFileName)" />
    </ItemGroup>
  </Target>

  <!--
    Do not DependsOn Build: this target is invoked from _WalkEachTargetPerFramework during
    pack, and GeneratePackageOnBuild/PackOnBuild already enter pack from Build — DependsOn
    Build here creates a cycle (MSB4006).
    Pack always runs after Build (dotnet pack / GeneratePackageOnBuild), so outputs exist.
  -->
  <Target Name="AddReadmePackageAssets"
          DependsOnTargets="CopyTaskAssemblyToBuild;ProcessPackageReadme">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(MSBuildProjectDirectory)\build\Readme.props" PackagePath="build/Readme.props" />
      <TfmSpecificPackageFile Include="$(MSBuildProjectDirectory)\build\Readme.targets" PackagePath="build/Readme.targets" />
      <TfmSpecificPackageFile Include="$(MSBuildProjectDirectory)\build\Readme.dll" PackagePath="build/Readme.dll"
                              Condition="Exists('$(MSBuildProjectDirectory)\build\Readme.dll')" />
      <TfmSpecificPackageFile Include="$(MSBuildProjectDirectory)\buildTransitive\Readme.props" PackagePath="buildTransitive/Readme.props" />
      <TfmSpecificPackageFile Include="$(MSBuildProjectDirectory)\buildTransitive\Readme.targets" PackagePath="buildTransitive/Readme.targets" />
      <TfmSpecificPackageFile Include="$(BaseIntermediateOutputPath)OSMFEULA.txt" PackagePath="OSMFEULA.txt"
                              Condition="Exists('$(BaseIntermediateOutputPath)OSMFEULA.txt')" />
      <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)..\icon.png" PackagePath="icon.png"
                              Condition="Exists('$(MSBuildThisFileDirectory)..\icon.png')" />
      <!--
        Do not pack the intermediate readme here — ProcessPackageReadme already
        adds it as None with PackagePath=readme.md. A second entry causes NU5118.
      -->
    </ItemGroup>
  </Target>

  <Target Name="ILRepackAddResolveLibs" BeforeTargets="ILRepack" Condition="'$(ILRepack)' == 'true'">
    <ItemGroup>
      <ReferenceCopyLocalPaths Include="@(ReferencePath)" Condition="
        '%(Filename)' == 'Microsoft.Build.Framework' Or
        '%(Filename)' == 'Microsoft.Build.Utilities.Core' Or
        '%(Filename)' == 'Microsoft.Build.Tasks.Core' Or
        '%(Filename)' == 'Microsoft.NET.StringTools'" />
    </ItemGroup>
  </Target>

  <Import Project="..\ILRepack.targets" />

  <!-- ========== Dev-only self-host (not shipped) ========== -->
  <PropertyGroup>
    <!--
      Fixed shadow path (UsingTask freezes AssemblyFile at registration — cannot use a guid).
      Never point at $(TargetPath) or build/Readme.dll: the node locks the loaded file forever.
    -->
    <_ReadmeTaskAssembly>$(MSBuildProjectDirectory)\obj\Readme.Task\Readme.dll</_ReadmeTaskAssembly>
    <ProcessPackageReadmeDependsOn>PrepareSelfHostReadmeTask;$(ProcessPackageReadmeDependsOn)</ProcessPackageReadmeDependsOn>
  </PropertyGroup>

  <!-- First UsingTask wins over build/Readme.targets. -->
  <UsingTask TaskName="Readme.ProcessPackageReadme" AssemblyFile="$(_ReadmeTaskAssembly)" />

  <!--
    Seed the shadow once. After ProcessPackageReadme runs, MSBuild holds a lock on the
    shadow for the node lifetime — further copies fail. ContinueOnError allows re-entry
    when this target is a DependsOn of multiple pack targets in the same node.
  -->
  <!-- No DependsOn Build: ProcessPackageReadme runs during pack; Build→Pack→…→Build cycles. -->
  <Target Name="PrepareSelfHostReadmeTask">
    <MakeDir Directories="$(MSBuildProjectDirectory)\obj\Readme.Task" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFiles="$(_ReadmeTaskAssembly)"
          SkipUnchangedFiles="true"
          Retries="0"
          ContinueOnError="WarnAndContinue"
          Condition="Exists('$(TargetPath)')" />
  </Target>

  <!--
    Stage license next to other pack inputs under intermediate output. SDK Pack NU5030
    rejects PackageLicenseFile when the only source is a Content item outside the project
    with Pack metadata stripped; packing a project-local staged copy is reliable.
  -->
  <Target Name="StagePackageLicense" BeforeTargets="AddReadmePackageAssets;GenerateNuspec;Pack"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\osmfeula.txt')">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\osmfeula.txt"
          DestinationFiles="$(BaseIntermediateOutputPath)OSMFEULA.txt"
          SkipUnchangedFiles="true" />
    <PropertyGroup>
      <PackageLicenseFile>OSMFEULA.txt</PackageLicenseFile>
      <PackageLicenseExpression></PackageLicenseExpression>
      <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    </PropertyGroup>
  </Target>

  <Import Project="build\Readme.props" Condition="Exists('$(MSBuildThisFileDirectory)build\Readme.props')" />
  <Import Project="build\Readme.targets" Condition="Exists('$(MSBuildThisFileDirectory)build\Readme.targets')" />
</Project>
