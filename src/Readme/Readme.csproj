<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>Readme</PackageId>
    <Description>
      Automatic package readme packing, include-directive resolution, token replacement,
      and GitHub relative URL expansion at pack time.
      Works with SDK Pack and NuGetizer: processes includes into BaseIntermediateOutputPath and packs that file.
    </Description>
    <PackageTags>readme nuget pack include markdown msbuild github</PackageTags>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- Build package: pack None under relative paths (build/, buildTransitive/). -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackBuildOutput>false</PackBuildOutput>
    <PackNone>true</PackNone>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <Nullable>enable</Nullable>
    <LangVersion>Latest</LangVersion>
    <!-- Always merge Markdig so build/Readme.dll is self-contained (no satellite deps). -->
    <ILRepack>true</ILRepack>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="17.11.48" PrivateAssets="all" />
    <PackageReference Include="Markdig" Version="1.3.2" PrivateAssets="all" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" PrivateAssets="all" />
    <PackageReference Include="NuGetizer" Version="1.4.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Merge Markdig + polyfills into the task assembly (same set as NuGetizer). -->
    <ILRepackInclude Include="Markdig" />
    <ILRepackInclude Include="System.Buffers" />
    <ILRepackInclude Include="System.Memory" />
    <ILRepackInclude Include="System.Numerics.Vectors" />
    <ILRepackInclude Include="System.Runtime.CompilerServices.Unsafe" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build\Readme.props" />
    <None Include="build\Readme.targets" />
    <None Include="buildTransitive\Readme.props" />
    <None Include="buildTransitive\Readme.targets" />
  </ItemGroup>

  <!-- Copy task assembly into build/ so it ships at build/Readme.dll -->
  <Target Name="CopyTaskAssemblyToBuild" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\build" SkipUnchangedFiles="true" />
    <ItemGroup>
      <None Include="build\$(TargetFileName)" Condition="!Exists('@(None)') or '@(None)' == ''" />
      <None Include="build\$(TargetFileName)" />
      <FileWrites Include="build\$(TargetFileName)" />
    </ItemGroup>
  </Target>

  <!--
    Repo Directory.Build.targets matches Filename 'readme' case-insensitively and sets
    PackagePath=%(Filename)%(Extension), which flattens Readme.props/targets. Restore correct paths.
  -->
  <PropertyGroup>
    <InferPackageContentsDependsOn>FixBuildPackagePaths;$(InferPackageContentsDependsOn)</InferPackageContentsDependsOn>
    <GetPackageContentsDependsOn>FixBuildPackagePaths;$(GetPackageContentsDependsOn)</GetPackageContentsDependsOn>
  </PropertyGroup>

  <Target Name="FixBuildPackagePaths">
    <ItemGroup>
      <None Remove="build\**\*.*;buildTransitive\**\*.*" />
      <None Include="$(MSBuildProjectDirectory)\build\Readme.props" Pack="true" PackagePath="build/Readme.props" PackFolder="build" />
      <None Include="$(MSBuildProjectDirectory)\build\Readme.targets" Pack="true" PackagePath="build/Readme.targets" PackFolder="build" />
      <None Include="$(MSBuildProjectDirectory)\build\Readme.dll" Pack="true" PackagePath="build/Readme.dll" PackFolder="build" Condition="Exists('$(MSBuildProjectDirectory)\build\Readme.dll')" />
      <None Include="$(MSBuildProjectDirectory)\buildTransitive\Readme.props" Pack="true" PackagePath="buildTransitive/Readme.props" PackFolder="buildTransitive" />
      <None Include="$(MSBuildProjectDirectory)\buildTransitive\Readme.targets" Pack="true" PackagePath="buildTransitive/Readme.targets" PackFolder="buildTransitive" />
    </ItemGroup>
  </Target>

  <!--
    MSBuild 17 packages ship ref assemblies that are not copy-local, so ILRepack cannot
    resolve Microsoft.Build.Framework when merging Markdig. Add those ReferencePath entries
    as resolve-only /lib directories (not ILRepackInclude, so they are not merged).
  -->
  <Target Name="ILRepackAddResolveLibs" BeforeTargets="ILRepack" Condition="'$(ILRepack)' == 'true'">
    <ItemGroup>
      <ReferenceCopyLocalPaths Include="@(ReferencePath)" Condition="
        '%(Filename)' == 'Microsoft.Build.Framework' Or
        '%(Filename)' == 'Microsoft.Build.Utilities.Core' Or
        '%(Filename)' == 'Microsoft.Build.Tasks.Core' Or
        '%(Filename)' == 'Microsoft.NET.StringTools'" />
    </ItemGroup>
  </Target>

  <Import Project="..\ILRepack.targets" />
</Project>
